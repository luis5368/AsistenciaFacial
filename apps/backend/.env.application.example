# Copiar a .env.application SOLO localmente. No contiene credenciales ni institución predeterminada.
# No copiar MIGRATION_DATABASE_URL ni .env del migrador a este archivo.
NODE_ENV=development
API_INSTITUTION_ID=
# Array JSON obligatorio: schoolYear, startsAt y endsAt UTC canónicos, límites [inicio,fin).
API_CALENDAR_JSON=
API_PORT=3001
API_ORIGIN=https://localhost:3001
SYNC_MAX_AGE_HOURS=24
SYNC_FUTURE_TOLERANCE_MINUTES=5
# Solo rol asistencia_app. Nunca copiar la URL de migración.
DATABASE_URL=
# Archivos locales privados; no se instalan en el almacén de certificados del SO.
LOCAL_TLS_KEY=../../.tmp/tls-auth/localhost.key
LOCAL_TLS_CERT=../../.tmp/tls-auth/localhost.crt
