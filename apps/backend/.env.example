# Copiar a apps/backend/.env, excluido de Git. Nunca colocar valores reales aquí.
# Desarrollo local exclusivamente. Credenciales distintas, obtenidas fuera del repositorio.
# Formato app: postgresql://asistencia_app:<CLAVE_URL_ENCODED>@localhost:5432/asistencia_facial
DATABASE_URL=
# Formato migrador: postgresql://asistencia_migrator:<CLAVE_URL_ENCODED>@localhost:5432/asistencia_facial
# Dejar vacío hasta revisión de permisos, respaldo y autorización expresa de migración.
MIGRATION_DATABASE_URL=
NODE_ENV=development

# Solo en archivo privado apps/backend/.env.sandbox, nunca copiar valores aquí:
# SANDBOX_MIGRATION_DATABASE_URL= (migrador, localhost:5432/asistencia_facial_sandbox)
# Prisma lo carga únicamente con PRISMA_SANDBOX=1. schema=public es opcional.
